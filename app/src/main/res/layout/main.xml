<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <WebView android:id="@+id/web"
        android:layout_width="match_parent" android:layout_height="match_parent"/>
    <LinearLayout android:layout_gravity="top" android:orientation="vertical"
        android:background="#CC000000" android:padding="6dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:orientation="horizontal"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <EditText android:id="@+id/server" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content"
                android:hint="server-url" android:textSize="11sp" android:textColor="#FFFFFF"
                android:textColorHint="#88FFFFFF" android:inputType="textUri" android:maxLines="1"/>
            <Button android:id="@+id/save" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Spara"/>
        </LinearLayout>
        <LinearLayout android:orientation="horizontal"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <EditText android:id="@+id/url" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content"
                android:hint="bank.se" android:textSize="11sp" android:textColor="#FFFFFF"
                android:textColorHint="#88FFFFFF" android:inputType="textUri" android:maxLines="1"/>
            <Button android:id="@+id/go" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Gå"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_gravity="bottom" android:orientation="horizontal"
        android:background="#CC000000" android:padding="6dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:id="@+id/status" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="#FFFFFF" android:textSize="11sp" android:text="…"/>
        <Button android:id="@+id/share" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Dela"/>
        <Button android:id="@+id/mode" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="→ kund"/>
        <Button android:id="@+id/reload" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Om"/>
    </LinearLayout>
</FrameLayout>
